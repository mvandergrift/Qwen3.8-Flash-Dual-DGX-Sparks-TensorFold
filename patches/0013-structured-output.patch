+            const found = try sc.top(sc.ctx, r, bits, &scan_v, &scan_id);
+            @memcpy(values[n..][0..found], scan_v[0..found]);
+            @memcpy(ids[n..][0..found], scan_id[0..found]);
+            n += found;
+            // a full scan leaves out tokens at or below its last; a short one listed every allowed token of the shard
+            const shard_floor = if (found == scan_width) scan_v[found - 1] else -std.math.inf(f32);
+            stats.scanned += 1;
+            if (!certifiedAt(values[0..n], need, @max(below_rest, shard_floor))) stats.inexact += 1;
+        } else if (n > 0) stats.inexact += 1;
+        if (n == 0) {
+            stats.missed += 1;
+            out[r] = .{ .token = lowestAllowed(bits).? };
+            continue;
+        }
+        out[r] = try drawRow(gpa, values[0..n], ids[0..n], positions[r], s, null);
+    }
+}
+
+/// A shard's row of bf16 logits (`row`, token ids `offset` + index): its best `values.len` allowed tokens by value, ties
+/// by id, in `values` and `ids`; how many there were (fewer than asked: all of the shard's allowed tokens).
+pub fn topAllowed(row: []const u16, offset: u64, bits: []const u32, values: []f32, ids: []u64) usize {
+    var n: usize = 0;
+    for (row, 0..) |h, i| {
+        const id = offset + i;
+        if (!allowedBit(bits, id)) continue;
+        const v: f32 = @bitCast(@as(u32, h) << 16);
+        if (std.math.isNan(v)) continue;
+        if (n == values.len and v <= values[n - 1]) continue; // a later id never beats an equal value
+        var at = if (n < values.len) n else n - 1;
+        while (at > 0 and v > values[at - 1]) : (at -= 1) {
+            values[at] = values[at - 1];
+            ids[at] = ids[at - 1];
+        }
+        values[at] = v;
+        ids[at] = id;
+        if (n < values.len) n += 1;
+    }
+    return n;
+}
+
+/// At least `need` of the candidates' values reach `floor`, the value every token a rank left out stays at or below: the
+/// best `need` allowed tokens are among them, so the draw over them is the draw over the whole vocabulary.
+fn certifiedAt(values: []const f32, need: usize, floor: f32) bool {
+    var reach: usize = 0;
+    for (values) |v| reach += @intFromBool(v >= floor);
+    return reach >= need;
+}
+
+fn allowedBit(bits: []const u32, token: usize) bool {
+    return token / 32 < bits.len and (bits[token / 32] >> @intCast(token % 32)) & 1 == 1;
+}
+
+fn lowestAllowed(bits: []const u32) ?u64 {
+    for (bits, 0..) |w, i| {
+        if (w != 0) return @as(u64, i) * 32 + @ctz(w);
+    }
+    return null;
+}
