+    try std.testing.expectEqualSlices(u32, &.{ 0, 1, 2 }, f.rows);
+    try std.testing.expectEqualSlices(u32, &.{ 1 << 7, std.math.maxInt(u32), std.math.maxInt(u32) }, f.masks);
+}
